# Database
# Compose 里 backend 的 DATABASE_URL 由 POSTGRES_PASSWORD 自动生成；勿在 .env 里另写一套不一致的 DATABASE_URL。
# 密码勿含未转义的 #（在 .env 里 # 会当成注释）；含特殊字符时优先只用 POSTGRES_PASSWORD，不要用复杂 URL。
POSTGRES_PASSWORD=postgres

# JWT Auth
JWT_SECRET=your-jwt-secret-change-in-production

# ─── AI Models ───────────────────────────────────────────────────────────────
# 全局主模型:火山方舟(Ark) 豆包,同一 ARK_API_KEY / ARK_BASE_URL,共 2 个模型:
#   文本 + 视觉解析: doubao-seed-2-1-pro-260628  (/chat/completions, /responses)
#   文生图:         doubao-seedream-5-0-pro-260628  (/images/generations)
# 获取 ARK_API_KEY:https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-2-1-pro-260628
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628

# QWEN 仅 vibe-snap-extract 独立子系统使用(视觉模型,支持 image_url 输入),与豆包主流程无关
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus
QWEN_VISION_MODEL=qwen3.6-plus

DEFAULT_AI_MODEL=ark

# SMTP Email (used for verification codes + cat emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Beta Access (comma-separated invite codes, e.g. CAT2026,MEOW888)
BETA_CODES=CAT2026

# Frontend（邮件里的链接、部分回调会用到，线上改成你的域名，含协议）
# 部署到 https://cucatopia.com 时请改成：
# FRONTEND_URL=https://cucatopia.com,https://www.cucatopia.com
FRONTEND_URL=http://localhost
