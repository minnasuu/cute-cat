# Database
# Compose 里 backend 的 DATABASE_URL 由 POSTGRES_PASSWORD 自动生成；勿在 .env 里另写一套不一致的 DATABASE_URL。
# 密码勿含未转义的 #（在 .env 里 # 会当成注释）；含特殊字符时优先只用 POSTGRES_PASSWORD，不要用复杂 URL。
POSTGRES_PASSWORD=postgres

# JWT Auth
JWT_SECRET=your-jwt-secret-change-in-production

# ─── AI Models ───────────────────────────────────────────────────────────────
# 全局文本/视觉模型:火山方舟(Ark) 豆包 —— 仅用于文本生成和视觉解析,与生图无关:
#   文本 + 视觉解析: doubao-seed-2-1-pro-260628  (/chat/completions, /responses)
# 获取 ARK_API_KEY:https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-2-1-pro-260628

# 全局生图模型:MaiziTech v2(maizitech.xyz) —— 仅用于图片生成:
#   文生图(/v2/images/generations, b64_json 响应): gpt-image-2
#   图像编辑(多图参考,图生图): 由 MAIZI_IMAGE_EDIT_MODEL 指定(走「真·参考图」,以款式图+面料图重做面料花样)
#   文档: https://www.maizitech.xyz/docs/images-v2
# 获取 MAIZI_API_KEY:https://www.maizitech.xyz 控制台
MAIZI_API_KEY=
MAIZI_BASE_URL=https://www.maizitech.xyz/v2
MAIZI_IMAGE_MODEL=gpt-image-2
MAIZI_RESOLUTION=1K          # 1K ≈ 1000px 级别(与 gpt-image-2 尺寸匹配)
MAIZI_QUALITY=medium          # standard / medium / high / low
# 材料组合生图模型:MaiziTech 图像编辑模型 id(多图参考,把款式图换成面料花样)。
# 模型名以其文档/控制台为准;首次联调若 4xx,优先核对 buildBody 的 image 字段名与编码(数组 vs 单图)。
MAIZI_IMAGE_EDIT_MODEL=

# QWEN 仅 vibe-snap-extract 独立子系统使用(视觉模型,支持 image_url 输入),与豆包主流程无关
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus
QWEN_VISION_MODEL=qwen3.6-plus

DEFAULT_AI_MODEL=ark

# 超时(单位 ms;豆包大 system prompt / SeedDream 大尺寸图场景首 token 延迟高,生图统一 3 分钟)
LAISSE_ANCIE_CHAT_TIMEOUT_MS=300000   # 聊天硬超时上限(默认 180s)
IMAGE_TIMEOUT_MS=180000               # 单张生图超时(3 分钟 / 180s)
INSPIRATION_AI_TIMEOUT_MS=120000      # 灵感视觉分析超时(默认 90s)

# SMTP Email (used for verification codes + cat emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Beta Access (comma-separated invite codes, e.g. CAT2026,MEOW888)
BETA_CODES=CAT2026

# Frontend（邮件里的链接、部分回调会用到，线上改成你的域名，含协议）
# 部署到 https://cucatopia.com 时请改成：
# FRONTEND_URL=https://cucatopia.com,https://www.cucatopia.com
FRONTEND_URL=http://localhost
