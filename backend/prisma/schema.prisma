generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== V2.0 用户系统 ====================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  nickname      String
  avatar        String?
  plan          String   @default("free")  // free / pro / enterprise
  aiQuota       Int      @default(100)
  aiUsed        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teams         Team[]
  aiCallLogs    AICallLog[]
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      String   // register / reset_password
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

// ==================== V2.0 团队系统 ====================

model Team {
  id          String    @id @default(uuid())
  name        String
  description String?   @db.Text
  icon        String?
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cats        TeamCat[]
  workflows   Workflow[]
  workflowRuns WorkflowRun[]
  aiCallLogs  AICallLog[]

  @@index([ownerId])
}

// ==================== V2.0 猫猫系统 ====================

model TeamCat {
  id           String   @id @default(uuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  templateId   String?
  name         String
  role         String
  description  String?  @db.Text
  catColors    Json
  systemPrompt String?  @db.Text
  skills       Json
  aiModel      String?
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(4096)
  accent       String   @default("#8DB889")
  item         String   @default("clipboard")
  messages     String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId])
}

// ==================== 工作流系统（重构） ====================

model Workflow {
  id                String   @id @default(uuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name              String
  icon              String   @default("📋")
  description       String   @db.Text
  placeholder       String?  @db.Text
  /** 前端分类用：ecommerce | selfmedia | internet */
  category          String   @default("ecommerce")
  steps             Json
  trigger           String   @default("manual") // manual / cron / webhook
  cron              String?
  startTime         String?
  endTime           String?
  persistent        Boolean  @default(false)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runs              WorkflowRun[]

  @@index([teamId])
}

model WorkflowRun {
  id            String    @id @default(uuid())
  workflowId    String?
  workflow      Workflow?  @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  triggeredBy   String?
  workflowName  String
  userInput     String?   @db.Text  // 用户输入的 prompt
  status        String    @default("running") // running / success / failed / cancelled
  steps         Json?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  totalDuration Int?
  createdAt     DateTime  @default(now())

  @@index([teamId])
  @@index([workflowId])
}

model AICallLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  catId         String?
  skillId       String?
  model         String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  duration      Int?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([teamId])
}

// ==================== Vibe Style 灵感库 ====================

model VibeStyleItem {
  id             String   @id @default(uuid())
  userId         String?
  isOfficial     Boolean  @default(false)
  aiEnabled      Boolean  @default(true)
  imageUrl       String
  tags           Json     // string[]
  colors         Json     // string[]
  summary        String   @db.Text
  designSummary  Json     // VibeSnapDesignSummary 对象
  designPrompt   String   @db.Text
  ownerName      String   @default("")
  createdAt      DateTime @default(now())

  @@index([userId])
}

// ==================== Vibe Assets: Fonts ====================

model VibeFontAsset {
  id         String   @id @default(uuid())
  userId     String?
  isOfficial Boolean  @default(false)
  aiEnabled  Boolean  @default(true)

  fileUrl    String   // /uploads/vibe-assets/fonts/<filename>
  filename   String
  mimeType   String
  sizeBytes  Int
  family     String   @default("")
  tags       Json     // string[]
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([aiEnabled])
  @@index([isOfficial])
}

// ==================== Laisse Ancie 品牌服装工作室 ====================

model LABrandProfile {
  id              String   @id @default(uuid())
  teamId          String   @unique
  nameZh          String
  nameEn          String
  cnFont          String   @default("站酷xiaowei体")
  enFont          String   @default("Poller One")
  sloganZh        String
  sloganEn        String
  greetingEn      String?
  voice           Json     @default("[\"优雅\",\"松弛\",\"乐趣\"]")
  audienceAgeMin  Int      @default(18)
  audienceAgeMax  Int      @default(30)
  priceMin        Int      @default(20)
  priceMax        Int      @default(500)
  systemSnippet   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LAColorPair {
  id        String   @id @default(uuid())
  teamId    String
  bg        String
  fg        String
  usage     String?
  createdAt DateTime @default(now())
  @@index([teamId])
}

model LAVisualAsset {
  id          String   @id @default(uuid())
  teamId      String
  kind        String
  title       String
  description String?  @db.Text
  src         String
  tags        Json     @default("[]")
  seasons     Json?
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([teamId])
  @@index([kind])
}

model LAInspirationAsset {
  id            String   @id @default(uuid())
  teamId        String
  url           String
  thumbUrl      String?
  mime          String
  bytes         Int
  width         Int      @default(0)
  height        Int      @default(0)
  category      String?
  silhouette    String?
  colors        Json     @default("[]")
  brandAnalysis String?  @db.Text
  designHighlights Json  @default("[]")
  styleFeatures    Json  @default("[]")
  // AI 分析状态: pending(待分析) | success(完成) | failed(失败) —— 用于前端 polling 与重试
  analysisStatus  String   @default("pending")
  // AI 分析失败原因(key | file | mime | api:xxx | json)—— 重试接口返回给前端用于排错
  analysisError   String?
  useCount      Int      @default(0)
  createdAt     DateTime @default(now())
  @@index([teamId])
  @@index([category])
  @@index([teamId, analysisStatus])
}

model LAMaterial {
  id          String   @id @default(uuid())
  teamId      String
  slug        String
  category    String
  name        String
  code        String
  supplier    String?
  origin      String?
  colors      Json
  composition String?
  weight      String?
  texture     String?
  finish      String?
  width       String?
  thickness   String?
  diameter    String?
  size        String?
  tex         String?
  shape       String?
  originNote  String?  @db.Text
  care        Json     @default("[]")
  uses        Json     @default("[]")
  seasons     Json     @default("[]")
  notes       String?  @db.Text
  priceAmount Float?
  priceCur    String?
  priceUnit   String?
  priceNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([teamId])
  @@index([category])
}

model LASkillArticle {
  id               String   @id @default(uuid())
  teamId           String
  category         String
  title            String
  zhTitle          String
  body             String   @db.Text
  tags             Json     @default("[]")
  relatedProducts  Json     @default("[]")
  relatedMaterials Json     @default("[]")
  systemHint       String?  @db.Text
  pinned           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([teamId])
  @@index([category])
}

model LAProduct {
  id                String   @id @default(uuid())
  teamId            String
  mode              String
  collectionId      String?
  collection        LACollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  title             String
  description       String   @db.Text
  seasons           Json     @default("[]")
  category          String?
  colors            Json     @default("[]")
  targetPriceNum    Int?
  silhouette        String?
  fabricId          String?
  fabricComposition String?
  liningId          String?
  liningComposition String?
  trimIds           Json?
  stitchNotes       String?  @db.Text
  measureTable      String?  @db.Text
  gradingNotes      String?  @db.Text
  patternUrl        String?
  techPackUrl       String?
  aiDraftRaw        String?  @db.Text
  fitAcknowledge    String?
  fitDetail         String?  @db.Text
  patternFinalUrl   String?
  factory           String?
  factoryContact    String?
  moq               Int?
  qty               Int?
  unitCostNum       Float?
  leadDays          Int?
  fabricSource      String?
  trimSource        String?
  fqcResult         String?
  sku               String?
  barcode           String?
  whLocation        String?
  imageUrl          String?
  status            String   @default("draft")
  statusHistory     Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([teamId])
  @@index([mode])
  @@index([status])
  @@index([collectionId])
}

model LACollection {
  id           String   @id @default(uuid())
  teamId       String
  mode         String
  title        String
  occasion     String?
  theme        String?
  seasons      Json     @default("[]")
  palette      Json     @default("[]")
  designerNote String?  @db.Text
  products     LAProduct[]
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([teamId])
}
