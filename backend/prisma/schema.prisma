generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== V2.0 用户系统 ====================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  nickname      String
  avatar        String?
  plan          String   @default("free")  // free / pro / enterprise (legacy,保留)
  aiQuota       Int      @default(100)     // legacy,计费已迁移到 coins
  aiUsed        Int      @default(0)       // legacy,计费已迁移到 coins
  // ── 用户角色 ──
  role          String   @default("user")      // admin / member / user
  coins         Int      @default(100)         // 喵币余额(注册即送 100)
  inviteCode    String?  @unique               // 个人邀请码
  invitedById   String?                       // 邀请人 id
  inviteCount   Int      @default(0)           // 已邀请成功人数
  // ── 新手引导 ──
  onboardingDone Boolean  @default(false)      // 是否已完成灵感扩散引导(服务端持久化,防换浏览器重复)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teams         Team[]
  aiCallLogs    AICallLog[]
  coinTransactions CoinTransaction[]
  communityPosts CommunityPost[]
  invitedUsers  User[]    @relation("UserInvites")
  invitedBy     User?     @relation("UserInvites", fields: [invitedById], references: [id])
  redeemedCodes RedemptionCode[]
  betaCodesUsed BetaCode[]

  @@index([inviteCode])
  @@index([invitedById])
}

// ─── 喵币流水 ───
model CoinTransaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int      // 正数=收入,负数=支出
  balanceAfter  Int      // 变动后余额(快照)
  type          String   // recharge / signup_bonus / invite_reward / ai_consume / refund
  refId         String?  // 关联 id(作品/订单等)
  note          String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, type])
}

// ─── 充值兑换码 ───
model RedemptionCode {
  id          String    @id @default(uuid())
  code        String    @unique   // 兑换码(用户输入,不区分大小写,存时转大写)
  tier        String    // basic / plus / pro 三档
  coins       Int       // 该档位对应喵币数
  used        Boolean   @default(false)
  usedById    String?   // 哪个用户已使用
  usedBy      User?     @relation(fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([code])
  @@index([usedById])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      String   // register / reset_password
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

// ==================== V2.0 团队系统 ====================

model Team {
  id            String    @id @default(uuid())
  name          String
  description   String?   @db.Text
  icon          String?
  /** 工作台类型: clothing(服装) / knitting(编织) / beading(串珠) / … */
  workspaceType String    @default("clothing")
  /** 是否官方工作台(官方工作台不可被用户修改/删除) */
  isOfficial    Boolean   @default(true)
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cats          TeamCat[]
  workflows     Workflow[]
  workflowRuns  WorkflowRun[]
  aiCallLogs    AICallLog[]

  @@index([ownerId])
  @@index([ownerId, workspaceType])
}

// ==================== V2.0 猫猫系统 ====================

model TeamCat {
  id           String   @id @default(uuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  templateId   String?
  name         String
  role         String
  description  String?  @db.Text
  catColors    Json
  systemPrompt String?  @db.Text
  skills       Json
  aiModel      String?
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(4096)
  accent       String   @default("#8DB889")
  item         String   @default("clipboard")
  messages     String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId])
}

// ==================== 工作流系统（重构） ====================

model Workflow {
  id                String   @id @default(uuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name              String
  icon              String   @default("📋")
  description       String   @db.Text
  placeholder       String?  @db.Text
  /** 前端分类用：ecommerce | selfmedia | internet */
  category          String   @default("ecommerce")
  steps             Json
  trigger           String   @default("manual") // manual / cron / webhook
  cron              String?
  startTime         String?
  endTime           String?
  persistent        Boolean  @default(false)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runs              WorkflowRun[]

  @@index([teamId])
}

model WorkflowRun {
  id            String    @id @default(uuid())
  workflowId    String?
  workflow      Workflow?  @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  triggeredBy   String?
  workflowName  String
  userInput     String?   @db.Text  // 用户输入的 prompt
  status        String    @default("running") // running / success / failed / cancelled
  steps         Json?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  totalDuration Int?
  createdAt     DateTime  @default(now())

  @@index([teamId])
  @@index([workflowId])
}

model AICallLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  catId         String?
  skillId       String?
  model         String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  duration      Int?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([teamId])
}

// ==================== Laisse Ancie 品牌服装工作室 ====================

model LABrandProfile {
  id              String   @id @default(uuid())
  teamId          String   @unique
  logo            String?
  name            String?
  cnFont          String   @default("站酷xiaowei体")
  enFont          String   @default("Poller One")
  slogan          String?
  voice           Json     @default("[]")
  audienceAgeMin  Int      @default(18)
  audienceAgeMax  Int      @default(30)
  priceMin        Int      @default(20)
  priceMax        Int      @default(500)
  systemSnippet   String?  @db.Text
  /** 自定义工序状态配置: [{ id, label, color }] —— 供 Lookbook/产品表格的「状态」列使用 */
  statusConfig    Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LAColorPair {
  id        String   @id @default(uuid())
  teamId    String
  bg        String
  fg        String
  usage     String?
  createdAt DateTime @default(now())
  @@index([teamId])
}

model LAVisualAsset {
  id          String   @id @default(uuid())
  teamId      String
  kind        String
  title       String
  description String?  @db.Text
  src         String
  tags        Json     @default("[]")
  seasons     Json?
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([teamId])
  @@index([kind])
}

model LAInspirationAsset {
  id            String   @id @default(uuid())
  teamId        String
  url           String
  thumbUrl      String?
  mime          String
  bytes         Int
  width         Int      @default(0)
  height        Int      @default(0)
  category      String?
  // —— 新 AI 分析结果(4 维度) ——
  visualStyle     String?  @db.Text
  designApproach  String?  @db.Text
  inspiration     Json     @default("[]")
  // —— 旧字段(弃用,保留兼容旧数据,新代码不再写入) ——
  silhouette    String?
  colors        Json     @default("[]")
  brandAnalysis String?  @db.Text
  designHighlights Json  @default("[]")
  styleFeatures    Json  @default("[]")
  // AI 分析状态: pending(待分析) | success(完成) | failed(失败) —— 用于前端 polling 与重试
  analysisStatus  String   @default("pending")
  // AI 分析失败原因(key | file | mime | api:xxx | json)—— 重试接口返回给前端用于排错
  analysisError   String?
  useCount      Int      @default(0)
  createdAt     DateTime @default(now())
  @@index([teamId])
  @@index([category])
  @@index([teamId, analysisStatus])
}

model LAMaterial {
  id          String   @id @default(uuid())
  teamId      String
  slug        String
  category    String
  name        String
  code        String
  supplier    String?
  origin      String?
  colors      Json
  composition String?
  weight      String?
  texture     String?
  finish      String?
  width       String?
  thickness   String?
  diameter    String?
  size        String?
  tex         String?
  shape       String?
  originNote  String?  @db.Text
  care        Json     @default("[]")
  uses        Json     @default("[]")
  seasons     Json     @default("[]")
  notes       String?  @db.Text
  priceAmount Float?
  priceCur    String?
  priceUnit   String?
  priceNote   String?
  /** 材料参考图 URL(上传接口 /materials/:id/image 写入) */
  image       String?
  /** 色卡列表:Array<{hex:string, url:string, name?:string}>;同一面料的多个颜色,每个颜色一张图 */
  colorImages Json     @default("[]")
  /** 管理员设为共享 → 所有用户可见可用(跨 teamId) */
  shared      Boolean  @default(false)
  /** 哪个管理员共享的(可审计) */
  sharedById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([teamId])
  @@index([category])
  @@index([shared])
}

model LAStyle {
  id        String   @id @default(uuid())
  teamId    String
  slug      String
  name      String
  category  String
  tags      Json     @default("[]")
  /** 款式参考图 URL(上传接口 /styles/:id/image 写入) */
  image      String?
  /** 管理员设为共享 → 所有用户可见可用(跨 teamId) */
  shared     Boolean  @default(false)
  /** 哪个管理员共享的(可审计) */
  sharedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([teamId])
  @@index([category])
  @@index([shared])
}

model LAIllustrationAsset {
  id        String   @id @default(uuid())
  teamId    String
  slug      String
  name      String
  tags      Json     @default("[]")
  /** 插画图片 URL(上传接口 /illustrations/:id/image 写入) */
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([teamId])
}

model LASkillArticle {
  id               String   @id @default(uuid())
  teamId           String
  category         String
  title            String
  zhTitle          String
  body             String   @db.Text
  tags             Json     @default("[]")
  relatedProducts  Json     @default("[]")
  relatedMaterials Json     @default("[]")
  systemHint       String?  @db.Text
  pinned           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([teamId])
  @@index([category])
}

model LAProduct {
  id                String   @id @default(uuid())
  teamId            String
  mode              String
  collectionId      String?
  collection        LACollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  title             String
  description       String   @db.Text
  seasons           Json     @default("[]")
  category          String?
  colors            Json     @default("[]")
  targetPriceNum    Int?
  silhouette        String?
  fabricId          String?
  fabricComposition String?
  liningId          String?
  liningComposition String?
  trimIds           Json?
  stitchNotes       String?  @db.Text
  measureTable      String?  @db.Text
  gradingNotes      String?  @db.Text
  patternUrl        String?
  techPackUrl       String?
  /** 设计工作流选定的材料 id(线稿→选材料→成图流程写入) */
  materialId        String?
  /** 设计工作流生成的图片数组:[{slot, label, url}] */
  images            Json     @default("[]")
  /** 生成图来源(与 images 按索引对齐):每张效果图的款式图 / 面料图(仅库来源有值,上传为 undefined)。材料组合专用。 */
  sourceImages      Json     @default("[]")
  /** 插画 HTML 模式:生成的自包含 HTML 文档,可在 iframe 画布渲染 */
  html              String?  @db.Text
  aiDraftRaw        String?  @db.Text
  /** 解析后的设计提案结构化字段(JSON,Lookbook 详情页分块展示) */
  sections          Json?
  fitAcknowledge    String?
  fitDetail         String?  @db.Text
  patternFinalUrl   String?
  factory           String?
  factoryContact    String?
  moq               Int?
  qty               Int?
  unitCostNum       Float?
  leadDays          Int?
  fabricSource      String?
  trimSource        String?
  fqcResult         String?
  sku               String?
  barcode           String?
  whLocation        String?
  imageUrl          String?
  /** 是否公开到社区 */
  isPublic          Boolean  @default(false)
  /** 社区中该作品的公开帖子(反向关系) */
  communityPosts    CommunityPost[]
  status            String   @default("draft")
  statusHistory     Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([teamId])
  @@index([mode])
  @@index([status])
  @@index([collectionId])
}

model LACollection {
  id           String   @id @default(uuid())
  teamId       String
  mode         String
  title        String
  occasion     String?
  theme        String?
  seasons      Json     @default("[]")
  palette      Json     @default("[]")
  designerNote String?  @db.Text
  products     LAProduct[]
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([teamId])
}

// ==================== 社区 —— 作品/反馈/通知 ====================

model CommunityPost {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // work(作品) / feedback(反馈) / announcement(官方通知)
  title       String
  content     String?  @db.Text
  /** 作品图数组:[{slot,label,url}] */
  images      Json     @default("[]")
  /** 作品类型时关联的 LAProduct.id */
  refProductId String?
  refProduct  LAProduct? @relation(fields: [refProductId], references: [id], onDelete: SetNull)
  likes       Int      @default(0)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, createdAt])
  @@index([userId])
  @@index([refProductId])
}

// ==================== 内测码（一次性准入） ====================

model BetaCode {
  id        String   @id @default(uuid())
  code      String   @unique   // 用户输入，存时大写去空格
  used      Boolean  @default(false)
  usedById  String?
  usedBy    User?    @relation(fields: [usedById], references: [id], onDelete: SetNull)
  usedAt    DateTime?
  note      String?             // 备注(管理员标记用途,如"发给 XX 媒体"/"KOL-A")
  createdBy String?             // 哪个管理员生成的(email)
  createdAt DateTime @default(now())

  @@index([code])
  @@index([used])
  @@index([usedById])
}

// ==================== 系统配置(key-value) ====================

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique   // 配置键(如 available_coins)
  value     String             // 配置值(JSON 字符串)
  note      String?            // 备注(说明用途)
  updatedBy String?            // 最后修改者(email)
  updatedAt DateTime @updatedAt

  @@index([key])
}
